{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.github.yuzhi.localsend",
  "name": "邻间",
  "version": "0.1.2",
  "publisher": "yuzhi",
  "description": "免登录局域网通讯：游客大厅、单聊群聊、图片文件与可信节点直连，支持网页访问。",
  "icon": "assets/plugin.svg",
  "homepage": "https://github.com/bobocha214/dbx-plugin-localsend",
  "engines": {
    "dbx": ">=0.6.0",
    "host_api": "1"
  },
  "permissions": [],
  "entrypoints": {
    "backend": {
      "protocol_versions": [
        1
      ],
      "transport": "stdio-jsonl",
      "executable": "bin/dbx-plugin-localsend"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.github.yuzhi.localsend",
      "label": "邻间",
      "icon": "assets/plugin.svg",
      "database_type": "localsend",
      "description": "打开即用的邻间，支持游客聊天、图片与大文件传输。",
      "fields": [
        {
          "key": "display_name",
          "label": "工作区名称",
          "type": "text",
          "binding": "name",
          "default": "邻间",
          "required": true,
          "description": "只用于标识这个工作区。网卡、端口、保存目录等在工作台内配置。"
        }
      ],
      "workbench": "io.github.yuzhi.localsend.workbench",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ]
    },
    {
      "type": "workbench",
      "id": "io.github.yuzhi.localsend.workbench",
      "label": "邻间",
      "description": "游客大厅、会话、群聊、图片文件与可信节点直连。",
      "icon": "assets/plugin.svg"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "邻间",
      "description": "免登录局域网通讯：游客大厅、单聊群聊、图片文件与可信节点直连，支持网页访问。",
      "contributions": {
        "io.github.yuzhi.localsend": {
          "label": "邻间",
          "description": "打开即用的邻间，支持游客聊天、图片与大文件传输。",
          "fields": {
            "display_name": {
              "label": "工作区名称",
              "description": "只用于标识这个工作区。本机别名、端口等在下方字段中配置。"
            },
            "alias": {
              "label": "本机别名"
            },
            "port": {
              "label": "本机端口"
            },
            "protocol": {
              "label": "传输协议"
            },
            "save_dir": {
              "label": "接收目录"
            },
            "network_interface": {
              "label": "选择网卡"
            }
          }
        },
        "io.github.yuzhi.localsend.workbench": {
          "label": "邻间",
          "description": "游客大厅、会话、群聊、图片文件与可信节点直连。"
        }
      }
    }
  },
  "source": "https://github.com/bobocha214/dbx-plugin-localsend"
}
